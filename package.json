{
  "name": "@asaf-labs/opencode-in-chrome",
  "version": "0.7.0",
  "bin": {
    "opencode-in-chrome": "scripts/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bridge/*.js",
    "extension/*.js",
    "extension/*.json",
    "extension/*.html",
    "extension/*.css",
    "scripts/cli.js",
    "scripts/cli-installation.js",
    "scripts/installation.js",
    "scripts/install.js",
    "scripts/pair.js",
    "scripts/pairing.js",
    "scripts/doctor.js",
    "scripts/diagnostics.js",
    "scripts/stop-shared.js",
    ".opencode/skills/install-opencode-in-chrome/SKILL.md",
    "examples/permissions.jsonc",
    "SECURITY.md",
    "npm-shrinkwrap.json"
  ],
  "license": "MIT",
  "description": "Session-owned Chrome tabs for OpenCode through an authenticated local MCP bridge.",
  "repository": {
    "type": "git",
    "url": "https://github.com/asaf-labs/opencode-in-chrome.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "node scripts/prepare-package.js",
    "prepublishOnly": "npm run check",
    "setup": "node bridge/setup.js",
    "install:opencode": "node scripts/install.js",
    "doctor": "node scripts/doctor.js",
    "pair": "node scripts/pair.js",
    "package": "node scripts/package.js",
    "start": "node bridge/main.js",
    "stop:shared": "node scripts/stop-shared.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node --test --test-concurrency=1 test/browser-click.test.js test/browser-frames.test.js test/browser-recording.test.js test/browser-inspection.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && node scripts/check-metadata.js && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "fflate": "0.8.3",
    "globals": "17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "3.9.10"
  }
}
