{
  "manifest_version": 3,
  "name": "OpenCode in Chrome",
  "version": "0.7.0",
  "description": "Let OpenCode sessions create and control their own Chrome tabs through MCP.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "alarms", "tabGroups", "debugger", "offscreen"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "OpenCode browser settings", "default_popup": "popup.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
